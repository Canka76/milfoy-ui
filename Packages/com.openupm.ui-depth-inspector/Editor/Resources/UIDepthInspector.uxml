<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="root" class="root">
        <!-- Toolbar -->
        <ui:VisualElement name="toolbar" class="toolbar">
            <ui:VisualElement name="toolbar-row-presets" class="toolbar-row">
                <ui:Button name="btn-front" text="Front" class="preset-btn" tooltip="Snap camera to Front Orthographic (True 2D View)" />
                <ui:Button name="btn-iso" text="Iso" class="preset-btn" tooltip="Snap camera to Isometric 45° Perspective View" />
                <ui:Button name="btn-side" text="Side" class="preset-btn" tooltip="Snap camera to Side Elevation View" />
                <ui:VisualElement class="toolbar-separator" />
                <ui:Label text="Z-Explosion:" class="slider-label" tooltip="Spreads UI layers apart along the Z-axis according to draw order" />
                <ui:Slider name="slider-explosion" low-value="0" high-value="50" value="0" class="explosion-slider" tooltip="Adjust 3D layer explosion separation distance" />
                <ui:FloatField name="field-explosion" value="0" class="explosion-field" />
            </ui:VisualElement>
            <ui:VisualElement name="toolbar-row-filters" class="toolbar-row">
                <ui:TextField name="search-field" class="search-field" placeholder-text="Search UI elements by name..." tooltip="Filter hierarchy items by name" />
                <ui:Toggle name="toggle-raycast" text="Raycast Only" class="filter-toggle" tooltip="Show only elements with raycastTarget enabled" />
                <ui:Toggle name="toggle-warnings" text="Warnings" class="filter-toggle" tooltip="Show only elements with invisible hitbox or size warnings" />
                <ui:Toggle name="toggle-active" text="Active Only" class="filter-toggle" tooltip="Hide inactive GameObjects" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main content split -->
        <ui:TwoPaneSplitView name="split-view" class="split-view" fixed-pane-index="1" fixed-pane-initial-dimension="380" orientation="Horizontal">
            <!-- Left: 3D Viewport (IMGUI) -->
            <ui:IMGUIContainer name="viewport-container" class="viewport" />

            <!-- Right: Stack list with Inline Diagnostics -->
            <ui:VisualElement name="list-pane" class="list-pane">
                <ui:ListView name="stack-list" class="stack-list" />

                <ui:VisualElement class="list-footer">
                    <ui:DropdownField name="canvas-filter" label="Canvas" class="canvas-dropdown" tooltip="Filter stack by root Canvas" />
                    <ui:Button name="btn-copy-stack" text="Copy Stack" class="copy-btn" tooltip="Copy formatted draw order stack and warnings to clipboard" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:TwoPaneSplitView>

        <!-- Status bar -->
        <ui:Label name="status-bar" text="No Canvas found" class="status-bar" />
    </ui:VisualElement>
</ui:UXML>
