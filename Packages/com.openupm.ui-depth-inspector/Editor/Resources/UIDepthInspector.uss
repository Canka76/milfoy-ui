.split-view {
    flex-grow: 1;
    flex-shrink: 1;
    height: 100%;
    width: 100%;
    min-height: 100px;
}

.toolbar {
    padding: 6px 8px;
    background-color: #242424;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
    flex-shrink: 0;
}

.toolbar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.preset-btn {
    width: 50px;
    margin-right: 2px;
}

.toolbar-separator {
    width: 1px;
    height: 16px;
    background-color: #444;
    margin-left: 6px;
    margin-right: 6px;
}

.slider-label {
    margin-right: 4px;
    -unity-font-style: bold;
    font-size: 11px;
}

.explosion-slider {
    flex-grow: 1;
    min-width: 100px;
}

.explosion-field {
    width: 50px;
    margin-left: 4px;
}

.search-field {
    flex-grow: 1;
    margin-right: 6px;
}

.search-field > .unity-text-field__input {
    padding-left: 4px;
}

.filter-toggle {
    margin-right: 6px;
    font-size: 11px;
}

.viewport {
    flex-grow: 1;
    height: 100%;
    min-width: 200px;
}

.list-pane {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 0;
    height: 100%;
    min-width: 340px;
}

.stack-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
}

.list-footer {
    flex-direction: row;
    padding: 4px 6px;
    border-top-width: 1px;
    border-top-color: #1a1a1a;
    background-color: #222222;
    align-items: center;
    flex-shrink: 0;
    margin-top: auto;
}

.canvas-dropdown {
    flex-grow: 1;
    margin-right: 4px;
}

.copy-btn {
    width: 90px;
}

.status-bar {
    padding: 3px 8px;
    background-color: #181818;
    font-size: 11px;
    color: #999;
    border-top-width: 1px;
    border-top-color: #121212;
    flex-shrink: 0;
}

/* Stack list row styles */
.stack-row-container {
    border-bottom-width: 1px;
    border-bottom-color: #2a2a2a;
    padding-top: 2px;
    padding-bottom: 2px;
}

.stack-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    height: 24px;
}

.stack-row:hover {
    background-color: #333333;
}

.stack-row--selected {
    background-color: #2c5d87;
}

.stack-index {
    width: 30px;
    min-width: 30px;
    flex-shrink: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #888;
    -unity-text-align: middle-right;
    margin-right: 6px;
}

.stack-dot {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    flex-shrink: 0;
    border-radius: 5px;
    margin-right: 6px;
}

.stack-dot--raycast { background-color: #E06060; }
.stack-dot--passive { background-color: #60A0E0; }
.stack-dot--ghost   { background-color: #FFB030; }
.stack-dot--inactive { background-color: #808080; }

.stack-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    margin-right: 4px;
}

.stack-name--inactive {
    color: #666;
}

.row-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
}

.row-btn {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin-left: 2px;
    font-size: 11px;
    padding: 0;
    -unity-text-align: middle-center;
}
